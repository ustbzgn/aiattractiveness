# ---------------------------------------------------------------------------
# aiattractiveness Environment Configuration Template
# Placeholders only. NEVER commit live secrets or real merchant credentials.
# Do NOT prefix backend secrets with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Application Identity & Public Origin
NEXT_PUBLIC_APP_NAME="ColorAI"
NEXT_PUBLIC_APP_URL="https://your-domain.com"
APP_PORT=3002

# Database Connection (PostgreSQL)
# Must connect to an isolated database or use the 'colorai_portal' schema
DATABASE_URL="postgresql://username:password@localhost:5432/colorai_db?schema=colorai_portal"
# Set to "false" when connecting to a local/Docker PostgreSQL container without SSL
DATABASE_SSL="true"

# Better Auth Configuration
# Unique secret and independent cookie prefix ensuring no collision with other apps
BETTER_AUTH_SECRET="aat_auth_secret_minimum_32_characters_long_placeholder"
BETTER_AUTH_URL="https://your-domain.com"

# Optional OAuth Providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Waffo Pancake MoR Merchant Configuration (Credit Packs)
# Note: Public webhooks cannot reach localhost. Use cloud staging for live tests.
WAFFO_MERCHANT_ID="merchant_sandbox_placeholder"
WAFFO_STORE_ID="store_sandbox_placeholder"
WAFFO_ENV="prod" # "test" | "prod"
WAFFO_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
WAFFO_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Server-Controlled Waffo Product IDs for Credit Packs (must match src/lib/config.ts)
WAFFO_PACK_1USD_PRODUCT_ID="PROD_pack_1usd_placeholder"
WAFFO_PACK_5USD_PRODUCT_ID="PROD_pack_5usd_placeholder"
WAFFO_PACK_10USD_PRODUCT_ID="PROD_pack_10usd_placeholder"
WAFFO_PACK_100USD_PRODUCT_ID="PROD_pack_100usd_placeholder"

# DeepSeek Portrait AI Engine (Server-only key)
DEEPSEEK_API_KEY="sk-placeholder-deepseek-api-key"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-flash"

# ToAPIs GPT-Image-2.5 Image Generation Engine
# Get your API Key from: https://toapis.com/dashboard
TOAPIS_API_KEY="sk-placeholder-toapis-api-key"
TOAPIS_BASE_URL="https://api.toapis.com" # Or https://api.toapis.cn for mainland China
TOAPIS_IMAGE_MODEL="gpt-image-2.5-flare" # "gpt-image-2.5-flare" or "gpt-image-2.5-sunburst"

