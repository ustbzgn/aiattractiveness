# ---------------------------------------------------------------------------
# aiattractiveness Environment Configuration Template
# Placeholders only. NEVER commit live secrets or real merchant credentials.
# Do NOT prefix backend secrets with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Application Identity & Public Origin
NEXT_PUBLIC_APP_NAME="Attractiveness AI"
NEXT_PUBLIC_APP_URL="http://localhost:3002"

# Database Connection (PostgreSQL)
# Must connect to an isolated database or use the 'aiattractiveness' schema
DATABASE_URL="postgresql://username:password@localhost:5432/aiattractiveness_db?schema=aiattractiveness"

# Better Auth Configuration
# Unique secret and independent cookie prefix ensuring no collision with other apps
BETTER_AUTH_SECRET="aat_auth_secret_minimum_32_characters_long_placeholder"
BETTER_AUTH_URL="http://localhost:3002"

# Waffo Pancake MoR Merchant Configuration (Credit Packs)
# Note: Public webhooks cannot reach localhost. Use ngrok or cloud staging for live tests.
WAFFO_MERCHANT_ID="merchant_sandbox_placeholder"
WAFFO_STORE_ID="store_sandbox_placeholder"
WAFFO_ENV="test" # "test" | "prod"
WAFFO_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
WAFFO_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Server-Controlled Waffo Product IDs for Credit Packs
WAFFO_PACK_STARTER_PRODUCT_ID="prod_pack_starter_placeholder"
WAFFO_PACK_STANDARD_PRODUCT_ID="prod_pack_standard_placeholder"
WAFFO_PACK_CREATOR_PRODUCT_ID="prod_pack_creator_placeholder"

# DeepSeek Portrait AI Engine (Server-only key for future reports)
DEEPSEEK_API_KEY="sk-placeholder-deepseek-api-key"
DEEPSEEK_MODEL="deepseek-flash"
